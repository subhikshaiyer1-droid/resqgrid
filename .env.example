# ==============================================================================
# ResQGrid Environment Variables Configuration (.env.example)
# ==============================================================================
#
# NOTE: ResQGrid features a zero-config Demo Mode! If these variables are omitted,
# the platform seamlessly runs in interactive Sandbox Mode with localStorage
# persistence and 9 realistic seeded emergency incidents and response teams.
#
# To connect your own live Supabase Cloud project:
# 1. Create a project at https://supabase.com
# 2. Run the SQL migration in supabase/migrations/20260101000000_resqgrid_schema.sql
# 3. Copy your project URL and Anon Key below:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
